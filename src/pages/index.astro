---
import source from '../../Home RI Impermeabilizacao.dc.html?raw';
import Seo from '../components/Seo.astro';
import { site } from '../config/site';

const helmet = source.match(/<helmet>([\s\S]*?)<\/helmet>/)?.[1] ?? '';
let page = source.match(/<x-dc>([\s\S]*?)<\/x-dc>/)?.[1] ?? '';

page = page
  .replace(/<helmet>[\s\S]*?<\/helmet>/, '')
  .replace(/<sc-if[^>]*>/g, '')
  .replace(/<\/sc-if>/g, '')
  .replaceAll('href="/sitemap.xml"', 'href="/sitemap-index.xml"')
  .replaceAll('href="#obras"', 'href="/obras"')
  .replace(
    '<nav style=',
    '<button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false">☰</button><nav class="main-nav" style=',
  )
  .replace('button type="button"', 'button class="form-submit" type="submit"');

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/images/logonovo.png`,
  image: `${site.url}${site.defaultImage}`,
  description: site.description,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    ...site.address,
  },
  areaServed: [
    { '@type': 'City', name: 'Itu' },
    { '@type': 'AdministrativeArea', name: 'Região de Sorocaba' },
    { '@type': 'State', name: 'São Paulo' },
  ],
  sameAs: site.social,
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Seo
      title="RI Impermeabilização | Proteção para sua obra"
      description={site.description}
      imageAlt="Serviços profissionais de impermeabilização da RI Impermeabilização"
      titleTemplate={false}
      schema={localBusinessSchema}
    />
    <Fragment set:html={helmet} />
  </head>
  <body>
    <Fragment set:html={page} />

    <script>
      const menuButton = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.main-nav');

      menuButton?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('is-open') ?? false;
        menuButton.setAttribute('aria-expanded', String(isOpen));
        menuButton.textContent = isOpen ? '×' : '☰';
      });

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.remove('is-open');
          menuButton?.setAttribute('aria-expanded', 'false');
          if (menuButton) menuButton.textContent = '☰';
        });
      });

      const form = document.querySelector('#contato form');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const button = form.querySelector('.form-submit');
        if (button instanceof HTMLButtonElement) {
          button.textContent = 'Solicitação recebida!';
          button.disabled = true;
        }
      });

      const blogCarousel = document.querySelector('[data-blog-carousel]');
      const blogButtons = document.querySelectorAll('[data-blog-direction]');

      blogButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (!(blogCarousel instanceof HTMLElement)) return;
          const firstCard = blogCarousel.querySelector('.blog-card');
          const cardWidth = firstCard instanceof HTMLElement ? firstCard.offsetWidth : blogCarousel.clientWidth;
          const direction = button.getAttribute('data-blog-direction') === 'previous' ? -1 : 1;
          blogCarousel.scrollBy({ left: direction * (cardWidth + 24), behavior: 'smooth' });
        });
      });

      const reviewsCarousel = document.querySelector('[data-reviews-carousel]');
      const reviewsButtons = document.querySelectorAll('[data-reviews-direction]');
      let reviewsAutoplay: ReturnType<typeof setInterval> | undefined;

      const stopReviewsAutoplay = () => {
        if (reviewsAutoplay) clearInterval(reviewsAutoplay);
        reviewsAutoplay = undefined;
      };

      const moveReviews = (direction: number) => {
        if (!(reviewsCarousel instanceof HTMLElement)) return;
        const firstReview = reviewsCarousel.querySelector('.review-card');
        const reviewWidth = firstReview instanceof HTMLElement ? firstReview.offsetWidth : reviewsCarousel.clientWidth;
        const reachedEnd = reviewsCarousel.scrollLeft + reviewsCarousel.clientWidth >= reviewsCarousel.scrollWidth - 4;
        const reachedStart = reviewsCarousel.scrollLeft <= 4;
        if (direction > 0 && reachedEnd) {
          reviewsCarousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else if (direction < 0 && reachedStart) {
          reviewsCarousel.scrollTo({ left: reviewsCarousel.scrollWidth, behavior: 'smooth' });
        } else {
          reviewsCarousel.scrollBy({ left: direction * (reviewWidth + 20), behavior: 'smooth' });
        }
      };

      const startReviewsAutoplay = () => {
        if (!(reviewsCarousel instanceof HTMLElement)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        stopReviewsAutoplay();
        reviewsAutoplay = setInterval(() => moveReviews(1), 4500);
      };

      reviewsButtons.forEach((button) => {
        button.addEventListener('click', () => {
          moveReviews(button.getAttribute('data-reviews-direction') === 'previous' ? -1 : 1);
          startReviewsAutoplay();
        });
      });

      if (reviewsCarousel instanceof HTMLElement) {
        reviewsCarousel.addEventListener('mouseenter', stopReviewsAutoplay);
        reviewsCarousel.addEventListener('mouseleave', startReviewsAutoplay);
        reviewsCarousel.addEventListener('focusin', stopReviewsAutoplay);
        reviewsCarousel.addEventListener('focusout', startReviewsAutoplay);
        reviewsCarousel.addEventListener('touchstart', stopReviewsAutoplay, { passive: true });
        reviewsCarousel.addEventListener('touchend', startReviewsAutoplay, { passive: true });
        startReviewsAutoplay();
      }

      const partnersCarousel = document.querySelector('[data-partners-carousel]');
      const partnersButtons = document.querySelectorAll('[data-partners-direction]');

      partnersButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (!(partnersCarousel instanceof HTMLElement)) return;
          const firstLogo = partnersCarousel.querySelector('.partner-logo');
          const logoWidth = firstLogo instanceof HTMLElement ? firstLogo.offsetWidth : partnersCarousel.clientWidth;
          const direction = button.getAttribute('data-partners-direction') === 'previous' ? -1 : 1;
          partnersCarousel.scrollBy({ left: direction * (logoWidth + 16), behavior: 'smooth' });
        });
      });

      let partnersAutoplay: ReturnType<typeof setInterval> | undefined;

      const stopPartnersAutoplay = () => {
        if (partnersAutoplay) clearInterval(partnersAutoplay);
        partnersAutoplay = undefined;
      };

      const startPartnersAutoplay = () => {
        if (!(partnersCarousel instanceof HTMLElement)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        stopPartnersAutoplay();
        partnersAutoplay = setInterval(() => {
          const firstLogo = partnersCarousel.querySelector('.partner-logo');
          const logoWidth = firstLogo instanceof HTMLElement ? firstLogo.offsetWidth : partnersCarousel.clientWidth;
          const reachedEnd = partnersCarousel.scrollLeft + partnersCarousel.clientWidth >= partnersCarousel.scrollWidth - 4;
          partnersCarousel.scrollTo({
            left: reachedEnd ? 0 : partnersCarousel.scrollLeft + logoWidth + 16,
            behavior: 'smooth',
          });
        }, 2800);
      };

      if (partnersCarousel instanceof HTMLElement) {
        partnersCarousel.addEventListener('mouseenter', stopPartnersAutoplay);
        partnersCarousel.addEventListener('mouseleave', startPartnersAutoplay);
        partnersCarousel.addEventListener('focusin', stopPartnersAutoplay);
        partnersCarousel.addEventListener('focusout', startPartnersAutoplay);
        partnersCarousel.addEventListener('touchstart', stopPartnersAutoplay, { passive: true });
        partnersCarousel.addEventListener('touchend', startPartnersAutoplay, { passive: true });
        startPartnersAutoplay();
      }
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid oklch(0.88 0.01 250);
    border-radius: 4px;
    background: #fff;
    color: oklch(0.35 0.08 250);
    font: 600 25px/1 Archivo, sans-serif;
    cursor: pointer;
  }

  [style-hover] {
    transition: transform 180ms ease, border-color 180ms ease,
      background-color 180ms ease, color 180ms ease;
  }

  article[style-hover]:hover {
    transform: translateY(-3px);
    border-color: oklch(0.7 0.06 250) !important;
  }

  .service-card-media {
    height: 220px;
    overflow: hidden;
    background: oklch(0.9 0.012 250);
  }

  .service-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  article[style-hover]:hover .service-card-media img {
    transform: scale(1.045);
  }

  .service-card {
    position: relative;
  }

  .service-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .service-card:focus-within {
    outline: 3px solid oklch(0.65 0.12 250);
    outline-offset: 3px;
  }

  .how-it-works {
    padding: 104px 32px;
    overflow: hidden;
    background: oklch(0.24 0.04 250);
    color: #fff;
  }

  .how-it-works-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(500px, 1.24fr);
    gap: 54px 40px;
    align-items: center;
  }

  .how-it-works-eyebrow {
    margin-bottom: 16px;
    color: oklch(0.75 0.15 70);
    font: 500 11.5px/1.4 "IBM Plex Mono", monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .how-it-works h2 {
    max-width: 620px;
    margin: 0 0 20px;
    color: #fff;
    font: 700 clamp(32px, 3.5vw, 48px)/1.07 Archivo, sans-serif;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .how-it-works-intro {
    max-width: 610px;
    margin: 0 0 34px;
    color: oklch(0.84 0.012 250);
    font-size: 16.5px;
    line-height: 1.7;
  }

  .layer-list {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
  }

  .layer-list li {
    min-width: 0;
    padding: 15px;
    display: flex;
    align-items: flex-start;
    gap: 13px;
    border: 1px solid oklch(0.43 0.035 250);
    border-radius: 5px;
    background: oklch(0.28 0.04 250 / 0.72);
  }

  .layer-list li > span {
    flex: 0 0 auto;
    color: oklch(0.75 0.15 70);
    font: 600 11px/1.4 "IBM Plex Mono", monospace;
  }

  .layer-list li > div {
    display: grid;
    gap: 5px;
  }

  .layer-list strong {
    color: #fff;
    font: 600 14px/1.3 Archivo, sans-serif;
  }

  .layer-list small {
    color: oklch(0.72 0.012 250);
    font-size: 11.5px;
    line-height: 1.45;
  }

  .layers-visual {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid oklch(0.44 0.035 250);
    border-radius: 8px;
    background: #050607;
    box-shadow: 0 24px 65px oklch(0.12 0.035 250 / 0.35);
  }

  .layers-visual::before {
    content: "";
    position: absolute;
    inset: 9% 8%;
    border-radius: 50%;
    background: oklch(0.47 0.1 250 / 0.2);
    filter: blur(50px);
  }

  .layers-visual img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: normal;
  }

  .how-it-works-benefits {
    grid-column: 1 / -1;
    padding-top: 30px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    border-top: 1px solid oklch(0.4 0.035 250);
  }

  .how-it-works-benefits > div {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .how-it-works-benefits > div > span {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid oklch(0.75 0.15 70);
    border-radius: 50%;
    color: oklch(0.75 0.15 70);
    font-weight: 700;
  }

  .how-it-works-benefits > div > div {
    display: grid;
    gap: 4px;
  }

  .how-it-works-benefits strong {
    color: #fff;
    font: 600 16px Archivo, sans-serif;
  }

  .how-it-works-benefits small {
    color: oklch(0.72 0.012 250);
    font-size: 12.5px;
  }

  a[style-hover]:hover,
  button[style-hover]:hover {
    filter: brightness(1.08);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid oklch(0.68 0.1 250 / 0.25);
    border-color: oklch(0.5 0.11 250) !important;
  }

  button:disabled {
    cursor: default !important;
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    body > div > div:first-child > div {
      justify-content: center !important;
      text-align: center;
    }

    body > div > div:first-child > div > div:first-child {
      display: none !important;
    }

    body > div > header > div {
      padding: 12px 20px !important;
      flex-wrap: nowrap !important;
    }

    .menu-toggle {
      display: block;
      margin-left: auto;
    }

    .main-nav {
      display: none !important;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 18px 20px 24px;
      background: #fff;
      border-bottom: 1px solid oklch(0.88 0.01 250);
      box-shadow: 0 12px 25px oklch(0.2 0.03 250 / 0.12);
      align-items: stretch !important;
      flex-direction: column;
      gap: 0 !important;
    }

    .main-nav.is-open {
      display: flex !important;
    }

    .how-it-works-inner {
      grid-template-columns: 1fr;
    }

    .layers-visual {
      width: min(680px, 100%);
      margin: 0 auto;
    }

    .how-it-works-benefits {
      grid-column: auto;
    }

    .main-nav > a {
      padding: 10px 4px;
    }

    body > div > section:nth-of-type(1) {
      min-height: 600px !important;
    }
  }

  @media (max-width: 640px) {
    body > div > section {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }

    body > div > section:nth-of-type(1) > div:last-child {
      padding: 90px 20px 62px !important;
    }

    body > div > section:nth-of-type(1) h1 {
      font-size: 38px !important;
    }

    body > div > section:nth-of-type(1) p {
      font-size: 17px !important;
    }

    body > div > section.hero-split { padding: 0 !important; }

    body > div > section.hero-split > .hero-media { padding: 0 !important; }

    #servicos,
    #obras,
    #diferenciais,
    #depoimentos,
    #blog,
    #contato {
      padding-top: 72px !important;
      padding-bottom: 72px !important;
    }

    .how-it-works {
      padding: 72px 20px;
    }

    .how-it-works-inner {
      gap: 42px;
    }

    .layer-list,
    .how-it-works-benefits {
      grid-template-columns: 1fr;
    }

    #contato > div > div:last-child {
      padding: 26px 20px !important;
    }

    body > div > footer {
      padding: 58px 20px 28px !important;
    }
  }
</style>
