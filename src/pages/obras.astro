---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import 'photoswipe/style.css';
import BlogLayout from '../layouts/BlogLayout.astro';
import { site, whatsappUrl } from '../config/site';

const imageModules = import.meta.glob<ImageMetadata>('../assets/obras/*.{jpg,jpeg}', {
  eager: true,
  import: 'default',
});

const imageFor = (filename: string) => {
  const entry = Object.entries(imageModules).find(([path]) => path.endsWith(`/${filename}`));
  if (!entry) throw new Error(`Imagem da obra não encontrada: ${filename}`);
  return entry[1];
};

const catalogo = [
  ['10-4.jpg', 'Piscina residencial', 'Piscinas', 'Impermeabilização completa da estrutura antes do revestimento.'],
  ['20-4.jpg', 'Cobertura impermeabilizada', 'Lajes', 'Tratamento técnico de laje para proteção contra infiltrações.'],
  ['1-8.jpg', 'Piscina e área de lazer', 'Piscinas', 'Execução do sistema impermeabilizante em piscina residencial.'],
  ['10-5.jpg', 'Laje com manta asfáltica', 'Lajes', 'Aplicação de manta asfáltica com acabamento técnico nas emendas.'],
  ['muro-de-arrimo.jpeg', 'Proteção de muro de arrimo', 'Fundações', 'Impermeabilização externa para bloquear a umidade do solo.'],
  ['10-7.jpg', 'Cobertura protegida', 'Lajes', 'Sistema de impermeabilização aplicado em área de grande exposição.'],
  ['IMG-20250423-WA0022.jpg', 'Piscina em execução', 'Piscinas', 'Tratamento contínuo de fundo, paredes e pontos críticos.'],
  ['baldrame_1-1.jpg', 'Impermeabilização de baldrame', 'Fundações', 'Proteção da fundação antes da continuidade da construção.'],
  ['WhatsApp-Image-2026-04-07-at-09.38.33.jpeg', "Reservatório d'água", "Caixas d'água", 'Superfície preparada e protegida para contato permanente com água.'],
  ['20-5.jpg', 'Varanda com manta asfáltica', 'Áreas molhadas', 'Tratamento da área externa antes da proteção mecânica.'],
  ['10-1.jpeg', 'Piscina residencial finalizada', 'Piscinas', 'Sistema impermeabilizante executado em toda a estrutura.'],
  ['IMG-20231113-WA0086.jpg', 'Contenção impermeabilizada', 'Fundações', 'Barreira contra umidade aplicada em estrutura de contenção.'],
  ['Imagem-do-WhatsApp-de-2025-12-01-as-15.23.41_4578a243.jpg', 'Laje de cobertura', 'Lajes', 'Área protegida para aumentar a durabilidade da edificação.'],
  ['1-4.jpg', 'Área molhada interna', 'Áreas molhadas', 'Tratamento impermeabilizante em ambiente interno.'],
  ['IMG-20250228-WA0030.jpg', 'Piscina com geometria especial', 'Piscinas', 'Execução cuidadosa em recortes, níveis e encontros da estrutura.'],
  ['20-6.jpg', 'Corredor externo protegido', 'Áreas molhadas', 'Aplicação de manta asfáltica em área exposta à chuva.'],
  ['10-11.jpg', 'Fundação em execução', 'Fundações', 'Proteção das estruturas em contato direto com o solo.'],
  ['IMG-20250423-WA0032.jpg', 'Piscina impermeabilizada', 'Piscinas', 'Tratamento uniforme de paredes, fundo e bordas.'],
  ['10-2.jpg', 'Complexo de piscinas', 'Piscinas', 'Impermeabilização técnica para múltiplos níveis e volumes.'],
  ['IMG-20240131-WA0060.jpg', 'Área técnica impermeabilizada', 'Áreas molhadas', 'Proteção em espaço externo de acesso restrito.'],
  ['20-11.jpg', 'Escada e tanque técnico', "Caixas d'água", 'Tratamento de superfícies e encontros internos.'],
  ['IMG-20231113-WA0077.jpg', 'Varanda em preparação', 'Áreas molhadas', 'Manta asfáltica aplicada antes do acabamento final.'],
  ['Imagem-do-WhatsApp-de-2025-11-18-as-08.55.00_19d14835.jpg', 'Reservatório impermeabilizado', "Caixas d'água", 'Proteção interna para estruturas submetidas à água.'],
  ['10-6.jpg', 'Piscina compacta', 'Piscinas', 'Impermeabilização contínua em fundo, paredes e degraus.'],
  ['IMG-20240324-WA0016.jpg', 'Varanda residencial', 'Áreas molhadas', 'Tratamento preventivo para uma área externa durável.'],
  ['1-9.jpg', 'Piscina com escada', 'Piscinas', 'Sistema aplicado em toda a geometria da estrutura.'],
  ['10-8.jpg', 'Piscina em tratamento', 'Piscinas', 'Detalhamento técnico em cantos, paredes e fundo.'],
  ['IMG-20250527-WA0040.jpg', 'Área externa impermeabilizada', 'Áreas molhadas', 'Proteção de piso e rodapés contra infiltrações.'],
  ['WhatsApp-Image-2026-04-07-at-10.04.24.jpeg', 'Cobertura em recuperação', 'Lajes', 'Preparação da superfície para receber o novo sistema.'],
  ['nova-piscina-01.jpg', 'Piscina com acabamento impermeável', 'Piscinas', 'Sistema aplicado de forma contínua em fundo e paredes.'],
  ['nova-laje-manta-01.jpg', 'Cobertura com manta asfáltica', 'Lajes', 'Proteção integral da cobertura com atenção aos encontros e bordas.'],
  ['nova-piscina-02.jpg', 'Piscina e área de lazer', 'Piscinas', 'Tratamento impermeabilizante aplicado em toda a estrutura.'],
  ['nova-piscina-03.jpg', 'Piscina com níveis integrados', 'Piscinas', 'Execução técnica em diferentes profundidades, degraus e paredes.'],
  ['nova-piscina-04.jpg', 'Piscina residencial em execução', 'Piscinas', 'Impermeabilização uniforme antes da etapa de revestimento.'],
  ['nova-piscina-05.jpg', 'Detalhamento de pontos hidráulicos', 'Piscinas', 'Cuidado especial nas passagens hidráulicas e demais pontos críticos.'],
  ['nova-piscina-06.jpg', 'Estrutura de piscina protegida', 'Piscinas', 'Sistema contínuo para proteger fundo, paredes e tubulações.'],
  ['nova-laje-manta-02.jpg', 'Laje com sistema asfáltico', 'Lajes', 'Aplicação de manta em cobertura exposta às variações climáticas.'],
  ['nova-laje-manta-03.jpg', 'Impermeabilização de cobertura', 'Lajes', 'Manta asfáltica aplicada com reforço em rodapés e elementos elevados.'],
  ['nova-laje-preparacao-01.jpg', 'Recuperação de laje', 'Lajes', 'Preparação e regularização da superfície para uma nova impermeabilização.'],
] as const;

const obras = catalogo.map(([filename, titulo, categoria, descricao], index) => ({
  image: imageFor(filename),
  titulo,
  categoria,
  descricao,
  local: 'Itu e região, SP',
  destaque: index === 0,
  formato: index === 0 ? 'featured' : [2, 6, 9, 13, 18, 22, 26, 30, 33, 36].includes(index) ? 'tall' : 'standard',
}));

const categorias = ['Todas', 'Lajes', 'Piscinas', "Caixas d'água", 'Fundações', 'Áreas molhadas'];
const obrasUrl = `${site.url}/obras/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Obras realizadas',
    url: obrasUrl,
    description: 'Galeria de obras de impermeabilização realizadas pela RI Impermeabilização em Itu e região.',
    inLanguage: site.language,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Obras realizadas', item: obrasUrl },
    ],
  },
];
---

<BlogLayout
  title="Obras realizadas"
  description="Conheça obras de impermeabilização executadas pela RI Impermeabilização em lajes, piscinas, reservatórios, fundações e áreas molhadas."
  image={obras[0].image.src}
  imageAlt="Piscina residencial impermeabilizada pela RI Impermeabilização"
  {schema}
>
  <section class="works-hero">
    <div class="hero-inner">
      <div>
        <p class="eyebrow">PORTFÓLIO RI</p>
        <h1>Obras realizadas</h1>
      </div>
      <p class="hero-intro">Cada obra exige um diagnóstico preciso e uma solução adequada. Conheça alguns dos trabalhos executados pela nossa equipe em Itu e região.</p>
    </div>
  </section>

  <section class="works-section">
    <div class="gallery-heading">
      <div>
        <p class="eyebrow">NOSSO TRABALHO</p>
        <h2>Soluções aplicadas em obras reais</h2>
      </div>
      <p><span data-visible-count>{obras.length}</span> registros</p>
    </div>

    <div class="filters" role="group" aria-label="Filtrar obras por categoria">
      {categorias.map((categoria, index) => (
        <button
          type="button"
          class:list={['filter-button', { active: index === 0 }]}
          data-filter={categoria}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {categoria}
        </button>
      ))}
    </div>

    <div class="works-grid" id="obras-gallery">
      {obras.map((obra, index) => (
        <a
          href={obra.image.src}
          class:list={['work-card', obra.formato]}
          data-category={obra.categoria}
          data-pswp-width={obra.image.width}
          data-pswp-height={obra.image.height}
          data-cropped="true"
          aria-label={`Ampliar foto: ${obra.titulo}`}
        >
          <Image
            src={obra.image}
            alt={`${obra.titulo} — ${obra.descricao}`}
            widths={[480, 720, 1080]}
            sizes={obra.destaque ? '(max-width: 700px) 100vw, 66vw' : '(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw'}
            loading={index < 3 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
          <span class="card-shade"></span>
          <span class="zoom-icon" aria-hidden="true">↗</span>
          <span class="work-info">
            <small>{obra.categoria}</small>
            <strong>{obra.titulo}</strong>
            <span>{obra.local}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="works-cta">
      <div>
        <p class="eyebrow">SEU PROJETO</p>
        <h2>Precisa proteger sua obra?</h2>
        <p>Converse com nossa equipe e solicite uma avaliação para definir a solução mais adequada.</p>
      </div>
      <a href={whatsappUrl('página de obras')} target="_blank" rel="noopener noreferrer">Solicite um orçamento <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BlogLayout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const grid = document.querySelector<HTMLElement>('#obras-gallery');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const visibleCount = document.querySelector('[data-visible-count]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.dataset.filter;
      let count = 0;

      buttons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });

      cards.forEach((card) => {
        const visible = selected === 'Todas' || card.dataset.category === selected;
        card.toggleAttribute('hidden', !visible);
        if (visible) count += 1;
      });

      if (visibleCount) visibleCount.textContent = String(count);
    });
  });

  if (grid) {
    const lightbox = new PhotoSwipeLightbox({
      gallery: grid,
      children: 'a.work-card:not([hidden])',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.94,
      showHideAnimationType: 'zoom',
    });
    lightbox.init();
  }
</script>

<style>
  .works-hero { padding: 94px 32px 88px; overflow: hidden; background: oklch(0.24 0.04 250); color: white; }
  .hero-inner { max-width: 1240px; margin: auto; display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(48px, 8vw, 120px); align-items: end; }
  .eyebrow { margin: 0 0 16px; color: oklch(0.75 0.15 70); font: 500 11.5px/1.4 "IBM Plex Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  h1 { margin: 0; font: 800 clamp(46px, 6vw, 78px)/.98 Archivo, sans-serif; letter-spacing: -.04em; }
  .hero-intro { max-width: 560px; margin: 0 0 4px; padding-left: 28px; border-left: 2px solid oklch(0.75 0.15 70); color: oklch(0.87 0.015 250); font-size: 18px; line-height: 1.7; }
  .works-section { max-width: 1304px; margin: auto; padding: 84px 32px 112px; }
  .gallery-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: 34px; }
  .gallery-heading h2, .works-cta h2 { margin: 0; color: oklch(0.25 0.04 250); font: 700 clamp(30px, 3.2vw, 44px)/1.08 Archivo, sans-serif; letter-spacing: -.028em; }
  .gallery-heading > p { margin: 0 0 4px; color: oklch(0.55 0.02 250); font: 500 11px "IBM Plex Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
  .filters { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 34px; }
  .filter-button { padding: 10px 15px; border: 1px solid oklch(0.87 0.012 250); border-radius: 999px; background: transparent; color: oklch(0.42 0.02 250); font: 600 13px Archivo, sans-serif; cursor: pointer; transition: color .18s ease, border-color .18s ease, background .18s ease; }
  .filter-button:hover { border-color: oklch(0.52 0.09 250); color: oklch(0.36 0.09 250); }
  .filter-button.active { border-color: oklch(0.31 0.065 250); background: oklch(0.31 0.065 250); color: white; }
  .works-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-flow: dense; grid-auto-rows: 112px; gap: 18px; }
  .work-card { position: relative; grid-row: span 3; min-height: 0; overflow: hidden; border-radius: 5px; background: oklch(0.26 0.04 250); color: white; isolation: isolate; }
  .work-card.tall { grid-row: span 4; }
  .work-card.featured { grid-column: span 2; grid-row: span 5; }
  .work-card[hidden] { display: none; }
  .work-card :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .card-shade { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, transparent 38%, oklch(0.16 0.04 250 / .88) 100%); transition: background .3s ease; }
  .work-info { position: absolute; right: 22px; bottom: 21px; left: 22px; z-index: 2; display: grid; gap: 5px; color: white; }
  .work-info small { color: oklch(0.81 0.15 75); font: 500 10px "IBM Plex Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .work-info strong { font: 700 clamp(18px, 2vw, 24px)/1.15 Archivo, sans-serif; letter-spacing: -.015em; }
  .work-info > span { color: oklch(0.83 0.012 250); font-size: 12.5px; }
  .zoom-icon { position: absolute; top: 16px; right: 16px; z-index: 2; width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid oklch(0.96 0.005 250 / .55); border-radius: 50%; background: oklch(0.18 0.04 250 / .35); color: white; font-size: 17px; opacity: 0; transform: translateY(5px); transition: opacity .25s ease, transform .25s ease; backdrop-filter: blur(5px); }
  .work-card:hover :global(img) { transform: scale(1.045); }
  .work-card:hover .zoom-icon, .work-card:focus-visible .zoom-icon { opacity: 1; transform: translateY(0); }
  .work-card:focus-visible { outline: 3px solid oklch(0.75 0.15 70); outline-offset: 3px; }
  .works-cta { margin-top: 90px; padding: clamp(34px, 5vw, 58px); display: flex; align-items: flex-end; justify-content: space-between; gap: 48px; border-radius: 6px; background: oklch(0.92 0.08 75); }
  .works-cta > div > p:last-child { max-width: 650px; margin: 17px 0 0; color: oklch(0.4 0.025 250); font-size: 16px; line-height: 1.65; }
  .works-cta > a { flex: 0 0 auto; padding: 16px 20px; border-radius: 4px; background: oklch(0.3 0.07 250); color: white; font: 700 14px Archivo, sans-serif; }
  .works-cta > a:hover { background: oklch(0.37 0.09 250); color: white; }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 34px; }
    .hero-intro { max-width: 680px; }
    .works-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .work-card.featured { grid-column: span 2; grid-row: span 4; }
    .works-cta { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 620px) {
    .works-hero { padding: 68px 20px; }
    .hero-intro { padding-left: 20px; font-size: 16.5px; }
    .works-section { padding: 62px 20px 80px; }
    .gallery-heading { align-items: flex-start; flex-direction: column; gap: 14px; }
    .filters { flex-wrap: nowrap; margin-inline: -20px; padding: 0 20px 6px; overflow-x: auto; scrollbar-width: none; }
    .filters::-webkit-scrollbar { display: none; }
    .filter-button { flex: 0 0 auto; }
    .works-grid { grid-template-columns: 1fr; grid-auto-rows: auto; gap: 14px; }
    .work-card, .work-card.tall, .work-card.featured { grid-column: auto; grid-row: auto; height: 390px; }
    .work-card.featured { height: 470px; }
    .work-info { right: 18px; bottom: 18px; left: 18px; }
    .zoom-icon { opacity: 1; transform: none; }
    .works-cta { margin-top: 64px; gap: 30px; }
    .works-cta > a { width: 100%; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card :global(img), .zoom-icon { transition: none; }
  }
</style>
