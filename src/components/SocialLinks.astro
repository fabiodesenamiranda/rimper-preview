---
import { site, whatsappUrl } from '../config/site';

interface Props { compact?: boolean; dark?: boolean }
const { compact = false, dark = false } = Astro.props;
---
<div class:list={['social-links', { compact, dark }]} aria-label="Redes sociais">
  <a href={site.links.facebook} target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook em uma nova aba">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.972h-1.513c-1.49 0-1.956.931-1.956 1.887v2.262h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" /></svg>
  </a>
  <a href={site.links.instagram} target="_blank" rel="noopener noreferrer" title="Instagram" aria-label="Instagram em uma nova aba">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
  </a>
  <a href={whatsappUrl('redes sociais')} target="_blank" rel="noopener noreferrer" title="WhatsApp" aria-label="WhatsApp em uma nova aba">
    <svg aria-hidden="true" viewBox="0 0 448 512" fill="currentColor"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.8l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.1-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
  </a>
  <a href={site.links.googleBusiness} target="_blank" rel="noopener noreferrer" title="Google Meu Negócio" aria-label="Google Meu Negócio em uma nova aba">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z" /><circle cx="12" cy="10" r="2.5" /></svg>
  </a>
</div>

<style>
  .social-links { display: flex; align-items: center; gap: 10px; }
  .social-links a { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: oklch(0.3 0.035 250); color: oklch(0.9 0.01 250); transition: background .18s ease, transform .18s ease; }
  .social-links a:hover { color: white; background: oklch(0.42 0.11 250); transform: translateY(-2px); }
  .social-links svg { width: 18px; height: 18px; }
  .social-links.compact { gap: 8px; }
  .social-links.compact a { width: 26px; height: 26px; background: oklch(0.94 0.008 250); color: oklch(0.38 0.08 250); }
  .social-links.compact a:hover { background: oklch(0.42 0.11 250); color: white; }
  .social-links.compact svg { width: 15px; height: 15px; }
  .social-links.compact svg[fill="none"] { stroke-width: 2.5; }
  .social-links.compact.dark a { border: 1.5px solid oklch(0.68 0.025 250); background: transparent; color: #fff; }
  .social-links.compact.dark a:hover { background: oklch(0.99 0.002 250 / .14); }
</style>
