---
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LgpdConsent from '../components/LgpdConsent.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, image, imageAlt, type = 'website', noindex = false, schema } = Astro.props;
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const FB_PIXEL_ID = import.meta.env.PUBLIC_FB_PIXEL_ID;
---
<!doctype html>
<html lang="pt-BR" data-ga-id={GA_ID} data-fb-pixel-id={FB_PIXEL_ID}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Seo {title} {description} {image} {imageAlt} {type} {noindex} {schema} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <LgpdConsent />
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: oklch(0.985 0.004 250); color: oklch(0.28 0.02 250); font-family: "Libre Franklin", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: oklch(0.42 0.11 250); text-decoration: none; }
  a:hover { color: oklch(0.55 0.15 250); }
  .topbar { background: oklch(0.28 0.06 250); color: oklch(0.92 0.01 250); font-size: 13px; }
  .topbar-inner { max-width: 1240px; margin: auto; padding: 10px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .topbar-location, .topbar-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .topbar-location span:last-child { opacity: .7; }
  .topbar-contact { gap: 20px; font-weight: 500; }
  .topbar-contact > a { color: oklch(0.92 0.01 250); }
  .topbar-contact > span { opacity: .4; }
  .topbar-contact > .topbar-whatsapp { color: oklch(0.85 0.13 145); }
  .site-header { position: sticky; top: 0; z-index: 30; background: oklch(0.995 0.002 250 / .97); border-bottom: 1px solid oklch(0.9 0.01 250); backdrop-filter: blur(10px); }
  .header-inner { max-width: 1240px; margin: auto; padding: 16px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; }
  .brand { display: flex; align-items: center; gap: 12px; color: oklch(0.3 0.04 250); font-family: Archivo, sans-serif; white-space: nowrap; }
  .brand img { width: 62px; height: 60px; object-fit: contain; }
  .site-nav { display: flex; align-items: center; gap: 24px; font-size: 14.5px; font-weight: 500; }
  .site-nav a { color: oklch(0.35 0.02 250); }
  .site-nav a[aria-current="page"] { color: oklch(0.42 0.11 250); font-weight: 700; }
  .site-nav > .quote,
  .site-nav > .quote:visited { padding: 12px 18px; border-radius: 4px; background: oklch(0.42 0.11 250); color: #fff !important; font-weight: 600; }
  .site-nav > .quote:hover,
  .site-nav > .quote:focus-visible { background: oklch(0.36 0.1 250); color: #fff !important; }
  .menu-toggle { display: none; width: 44px; height: 44px; border: 1px solid oklch(0.88 0.01 250); border-radius: 4px; background: #fff; color: oklch(0.35 0.08 250); font: 600 25px/1 Archivo, sans-serif; cursor: pointer; }
  footer { padding: 64px 32px 28px; background: oklch(0.22 0.035 250); color: oklch(0.8 0.015 250); }
  .footer-inner { max-width: 1240px; margin: auto; display: flex; justify-content: space-between; gap: 48px; padding-bottom: 44px; border-bottom: 1px solid oklch(0.32 0.03 250); }
  .footer-brand { color: white; }
  .footer-brand img { filter: brightness(0) invert(1); }
  .footer-inner p { max-width: 450px; line-height: 1.65; }
  .footer-links { max-width: 620px; display: flex; flex-wrap: wrap; align-content: flex-start; align-items: flex-start; justify-content: flex-end; gap: 18px 24px; }
  .footer-links a { color: oklch(0.88 0.01 250); }
  .copyright { max-width: 1240px; margin: 24px auto 0; font-size: 13px; color: oklch(0.68 0.02 250); }
  .whatsapp { position: fixed; right: 20px; bottom: 20px; z-index: 40; width: 58px; height: 58px; display: grid; place-items: center; border-radius: 50%; color: white; background: #25d366; box-shadow: 0 8px 24px oklch(0.3 0.06 145 / .35); }
  .whatsapp:hover { color: white; background: #1ebe5d; }
  .whatsapp svg { width: 31px; height: 31px; fill: currentColor; }
  @media (max-width: 900px) {
    .topbar-inner { justify-content: center; padding-inline: 20px; text-align: center; }
    .topbar-location { display: none; }
    .header-inner { position: relative; padding: 12px 20px; flex-wrap: nowrap; }
    .menu-toggle { display: block; margin-left: auto; }
    .site-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; padding: 18px 20px 24px; background: #fff; border-bottom: 1px solid oklch(0.88 0.01 250); box-shadow: 0 12px 25px oklch(0.2 0.03 250 / .12); align-items: stretch; flex-direction: column; gap: 0; }
    .site-nav.is-open { display: flex; }
    .site-nav > a { padding: 10px 4px; }
    .site-nav > .quote { margin-top: 8px; padding: 12px 18px; text-align: center; }
  }
  @media (max-width: 620px) {
    .topbar-contact > a:first-child, .topbar-contact > span { display: none; }
    .topbar-contact { justify-content: center; gap: 12px; }
    .brand strong { font-size: 14px; }
    footer { padding-inline: 20px; }
    .footer-inner { flex-direction: column; }
    .footer-links { flex-wrap: wrap; }
  }
</style>
