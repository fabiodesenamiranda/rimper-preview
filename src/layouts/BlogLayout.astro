---
import SocialLinks from '../components/SocialLinks.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, image, imageAlt, type = 'website', schema } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Seo {title} {description} {image} {imageAlt} {type} {schema} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="topbar">
      <div class="topbar-inner">
        <div class="topbar-location">
          <span>Rua Paulo Souza, 395 B Sobre loja — Centro, Itu · SP</span>
          <span>Seg a Sex, 08:00 às 17:00</span>
        </div>
        <div class="topbar-contact">
          <a href="tel:+551140131615">(11) 4013-1615</a>
          <span>|</span>
          <a class="topbar-whatsapp" href="https://wa.me/5511917351151" target="_blank" rel="noopener noreferrer">WhatsApp (11) 91735-1151</a>
          <SocialLinks compact dark />
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="RI Impermeabilização — página inicial">
          <img src="/images/logonovo.png" alt="" />
          <strong>RI Impermeabilização</strong>
        </a>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false">☰</button>
        <nav class="site-nav" aria-label="Navegação principal">
          <a href="/#servicos" aria-current={currentPath.startsWith('/servicos') ? 'page' : undefined}>Serviços</a>
          <a href="/obras" aria-current={currentPath.startsWith('/obras') ? 'page' : undefined}>Obras realizadas</a>
          <a href="/#diferenciais">Diferenciais</a>
          <a href="/#depoimentos">Depoimentos</a>
          <a href="/blog">Blog</a>
          <a href="/#contato">Contato</a>
          <a class="quote" href="https://wa.me/5511917351151" target="_blank" rel="noopener noreferrer">Solicite um orçamento</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div>
          <a class="brand footer-brand" href="/">
            <img src="/images/logonovo.png" alt="" />
            <strong>RI Impermeabilização</strong>
          </a>
          <p>Especialistas em impermeabilização residencial, comercial e industrial há mais de 30 anos.</p>
          <SocialLinks />
        </div>
        <div class="footer-links">
          <a href="/">Início</a>
          <a href="/obras">Obras realizadas</a>
          <a href="/blog">Blog</a>
          <a href="/#contato">Contato</a>
        </div>
      </div>
      <div class="copyright">RI Impermeabilização — Copyright © 2026. Todos os direitos reservados.</div>
    </footer>
    <a class="whatsapp" href="https://wa.me/5511917351151" target="_blank" rel="noopener noreferrer" aria-label="Fale pelo WhatsApp em uma nova aba">
      <svg aria-hidden="true" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.8l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.1-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
    </a>
    <script>
      const menuButton = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.site-nav');

      menuButton?.addEventListener('click', () => {
        const isOpen = menu?.classList.toggle('is-open') ?? false;
        menuButton.setAttribute('aria-expanded', String(isOpen));
        menuButton.textContent = isOpen ? '×' : '☰';
      });

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.remove('is-open');
          menuButton?.setAttribute('aria-expanded', 'false');
          if (menuButton) menuButton.textContent = '☰';
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: oklch(0.985 0.004 250); color: oklch(0.28 0.02 250); font-family: "Libre Franklin", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: oklch(0.42 0.11 250); text-decoration: none; }
  a:hover { color: oklch(0.55 0.15 250); }
  .topbar { background: oklch(0.28 0.06 250); color: oklch(0.92 0.01 250); font-size: 13px; }
  .topbar-inner { max-width: 1240px; margin: auto; padding: 10px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .topbar-location, .topbar-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .topbar-location span:last-child { opacity: .7; }
  .topbar-contact { gap: 20px; font-weight: 500; }
  .topbar-contact > a { color: oklch(0.92 0.01 250); }
  .topbar-contact > span { opacity: .4; }
  .topbar-contact > .topbar-whatsapp { color: oklch(0.85 0.13 145); }
  .site-header { position: sticky; top: 0; z-index: 30; background: oklch(0.995 0.002 250 / .97); border-bottom: 1px solid oklch(0.9 0.01 250); backdrop-filter: blur(10px); }
  .header-inner { max-width: 1240px; margin: auto; padding: 16px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; }
  .brand { display: flex; align-items: center; gap: 12px; color: oklch(0.3 0.04 250); font-family: Archivo, sans-serif; white-space: nowrap; }
  .brand img { width: 62px; height: 60px; object-fit: contain; }
  .site-nav { display: flex; align-items: center; gap: 24px; font-size: 14.5px; font-weight: 500; }
  .site-nav a { color: oklch(0.35 0.02 250); }
  .site-nav a[aria-current="page"] { color: oklch(0.42 0.11 250); font-weight: 700; }
  .site-nav > .quote,
  .site-nav > .quote:visited { padding: 12px 18px; border-radius: 4px; background: oklch(0.42 0.11 250); color: #fff !important; font-weight: 600; }
  .site-nav > .quote:hover,
  .site-nav > .quote:focus-visible { background: oklch(0.36 0.1 250); color: #fff !important; }
  .menu-toggle { display: none; width: 44px; height: 44px; border: 1px solid oklch(0.88 0.01 250); border-radius: 4px; background: #fff; color: oklch(0.35 0.08 250); font: 600 25px/1 Archivo, sans-serif; cursor: pointer; }
  footer { padding: 64px 32px 28px; background: oklch(0.22 0.035 250); color: oklch(0.8 0.015 250); }
  .footer-inner { max-width: 1240px; margin: auto; display: flex; justify-content: space-between; gap: 48px; padding-bottom: 44px; border-bottom: 1px solid oklch(0.32 0.03 250); }
  .footer-brand { color: white; }
  .footer-brand img { filter: brightness(0) invert(1); }
  .footer-inner p { max-width: 450px; line-height: 1.65; }
  .footer-links { display: flex; align-items: flex-start; gap: 24px; }
  .footer-links a { color: oklch(0.88 0.01 250); }
  .copyright { max-width: 1240px; margin: 24px auto 0; font-size: 13px; color: oklch(0.68 0.02 250); }
  .whatsapp { position: fixed; right: 20px; bottom: 20px; z-index: 40; width: 58px; height: 58px; display: grid; place-items: center; border-radius: 50%; color: white; background: #25d366; box-shadow: 0 8px 24px oklch(0.3 0.06 145 / .35); }
  .whatsapp:hover { color: white; background: #1ebe5d; }
  .whatsapp svg { width: 31px; height: 31px; fill: currentColor; }
  @media (max-width: 900px) {
    .topbar-inner { justify-content: center; padding-inline: 20px; text-align: center; }
    .topbar-location { display: none; }
    .header-inner { position: relative; padding: 12px 20px; flex-wrap: nowrap; }
    .menu-toggle { display: block; margin-left: auto; }
    .site-nav { display: none; position: absolute; top: 100%; left: 0; right: 0; padding: 18px 20px 24px; background: #fff; border-bottom: 1px solid oklch(0.88 0.01 250); box-shadow: 0 12px 25px oklch(0.2 0.03 250 / .12); align-items: stretch; flex-direction: column; gap: 0; }
    .site-nav.is-open { display: flex; }
    .site-nav > a { padding: 10px 4px; }
    .site-nav > .quote { margin-top: 8px; padding: 12px 18px; text-align: center; }
  }
  @media (max-width: 620px) {
    .topbar-contact > a:first-child, .topbar-contact > span { display: none; }
    .topbar-contact { justify-content: center; gap: 12px; }
    .brand strong { font-size: 14px; }
    footer { padding-inline: 20px; }
    .footer-inner { flex-direction: column; }
  }
</style>
